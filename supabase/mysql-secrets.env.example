# Copy to supabase/mysql-secrets.env and replace every placeholder.
# These are MySQL credentials, NOT Supabase keys or administrator passwords.
MYSQL_HOST=YOUR_REMOTE_MYSQL_HOSTNAME
MYSQL_PORT=3306
MYSQL_USER=YOUR_MYSQL_USER
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=YOUR_MYSQL_DATABASE
MYSQL_SSL=true
